# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000

# Neon → your project → Connect → copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Any long random string. Signs the login cookie so it can't be faked.
SESSION_SECRET=replace-with-a-long-random-string

# openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-your-key-here
# Optional: which AI model writes the summaries
OPENROUTER_MODEL=~anthropic/claude-sonnet-latest
